{
  "$schema": "vscode://schemas/color-theme",
  "name": "Matcha Latte",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#9FC48A",
    "foreground": "#EADFCF",
    "descriptionForeground": "#A39A8D",
    "errorForeground": "#E58B7A",
    "selection.background": "#8DB37C55",
    "widget.shadow": "#0000004D",
    "icon.foreground": "#D8CBB8",

    "editor.background": "#26221C",
    "editor.foreground": "#EADFCF",
    "editorCursor.foreground": "#9FC48A",
    "editor.lineHighlightBackground": "#2F2A22",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#8DB37C44",
    "editor.inactiveSelectionBackground": "#8DB37C22",
    "editor.selectionHighlightBackground": "#D9AE8222",
    "editor.wordHighlightBackground": "#D9AE8222",
    "editor.wordHighlightStrongBackground": "#9FC48A2A",
    "editor.findMatchBackground": "#C98B5E88",
    "editor.findMatchHighlightBackground": "#C98B5E44",
    "editor.rangeHighlightBackground": "#9FC48A14",
    "editorLineNumber.foreground": "#5A5145",
    "editorLineNumber.activeForeground": "#C9E0B4",
    "editorIndentGuide.background1": "#34302A",
    "editorIndentGuide.activeBackground1": "#685E51",
    "editorWhitespace.foreground": "#463F35",
    "editorRuler.foreground": "#34302A",
    "editorBracketMatch.background": "#9FC48A33",
    "editorBracketMatch.border": "#9FC48A88",
    "editorBracketHighlight.foreground1": "#9FC48A",
    "editorBracketHighlight.foreground2": "#D9AE82",
    "editorBracketHighlight.foreground3": "#7FB59A",
    "editorError.foreground": "#E58B7A",
    "editorWarning.foreground": "#E8C27A",
    "editorInfo.foreground": "#7FB59A",
    "editorGutter.addedBackground": "#8DB37C",
    "editorGutter.modifiedBackground": "#D9AE82",
    "editorGutter.deletedBackground": "#E58B7A",
    "editorWidget.background": "#201D18",
    "editorWidget.border": "#3B352C",
    "editorSuggestWidget.background": "#201D18",
    "editorSuggestWidget.border": "#3B352C",
    "editorSuggestWidget.selectedBackground": "#3B352C",
    "editorSuggestWidget.highlightForeground": "#9FC48A",
    "editorHoverWidget.background": "#201D18",
    "editorHoverWidget.border": "#3B352C",
    "editorGroupHeader.tabsBackground": "#201D18",
    "editorGroup.border": "#191612",

    "tab.activeBackground": "#26221C",
    "tab.activeForeground": "#EADFCF",
    "tab.activeBorderTop": "#9FC48A",
    "tab.inactiveBackground": "#201D18",
    "tab.inactiveForeground": "#8B7F6E",
    "tab.border": "#191612",
    "tab.unfocusedActiveBorderTop": "#9FC48A55",

    "activityBar.background": "#191612",
    "activityBar.foreground": "#C9E0B4",
    "activityBar.inactiveForeground": "#685E51",
    "activityBar.activeBorder": "#9FC48A",
    "activityBarBadge.background": "#9FC48A",
    "activityBarBadge.foreground": "#191612",

    "sideBar.background": "#201D18",
    "sideBar.foreground": "#D8CBB8",
    "sideBar.border": "#191612",
    "sideBarTitle.foreground": "#EADFCF",
    "sideBarSectionHeader.background": "#26221C",
    "sideBarSectionHeader.foreground": "#D8CBB8",
    "list.activeSelectionBackground": "#3B352C",
    "list.activeSelectionForeground": "#EADFCF",
    "list.inactiveSelectionBackground": "#2F2A22",
    "list.hoverBackground": "#2A261F",
    "list.focusOutline": "#9FC48A88",
    "list.highlightForeground": "#9FC48A",

    "titleBar.activeBackground": "#191612",
    "titleBar.activeForeground": "#D8CBB8",
    "titleBar.inactiveBackground": "#191612",
    "titleBar.inactiveForeground": "#685E51",
    "titleBar.border": "#191612",

    "statusBar.background": "#8DB37C",
    "statusBar.foreground": "#191612",
    "statusBar.border": "#8DB37C",
    "statusBar.noFolderBackground": "#C98B5E",
    "statusBar.debuggingBackground": "#D9AE82",
    "statusBar.debuggingForeground": "#191612",
    "statusBarItem.remoteBackground": "#5A4A38",
    "statusBarItem.remoteForeground": "#EADFCF",
    "statusBarItem.hoverBackground": "#19161222",

    "panel.background": "#201D18",
    "panel.border": "#3B352C",
    "panelTitle.activeBorder": "#9FC48A",
    "panelTitle.activeForeground": "#EADFCF",
    "panelTitle.inactiveForeground": "#8B7F6E",

    "button.background": "#8DB37C",
    "button.foreground": "#191612",
    "button.hoverBackground": "#9FC48A",
    "button.secondaryBackground": "#5A4A38",
    "button.secondaryForeground": "#EADFCF",
    "badge.background": "#C98B5E",
    "badge.foreground": "#191612",
    "input.background": "#191612",
    "input.border": "#3B352C",
    "input.foreground": "#EADFCF",
    "input.placeholderForeground": "#685E51",
    "inputOption.activeBorder": "#9FC48A",
    "dropdown.background": "#191612",
    "dropdown.border": "#3B352C",
    "checkbox.background": "#191612",
    "checkbox.border": "#3B352C",
    "progressBar.background": "#9FC48A",
    "scrollbarSlider.background": "#D8CBB81A",
    "scrollbarSlider.hoverBackground": "#D8CBB833",
    "scrollbarSlider.activeBackground": "#D8CBB84D",
    "textLink.foreground": "#9FC48A",
    "textLink.activeForeground": "#C9E0B4",

    "terminal.background": "#201D18",
    "terminal.foreground": "#EADFCF",
    "terminalCursor.foreground": "#9FC48A",
    "terminal.ansiBlack": "#191612",
    "terminal.ansiRed": "#E58B7A",
    "terminal.ansiGreen": "#9FC48A",
    "terminal.ansiYellow": "#E8C27A",
    "terminal.ansiBlue": "#8FB0C4",
    "terminal.ansiMagenta": "#C8A0B8",
    "terminal.ansiCyan": "#7FB59A",
    "terminal.ansiWhite": "#D8CBB8",
    "terminal.ansiBrightBlack": "#685E51",
    "terminal.ansiBrightRed": "#F0A495",
    "terminal.ansiBrightGreen": "#C9E0B4",
    "terminal.ansiBrightYellow": "#F2D49A",
    "terminal.ansiBrightBlue": "#A9C6D8",
    "terminal.ansiBrightMagenta": "#DDB9CE",
    "terminal.ansiBrightCyan": "#9ACDB3",
    "terminal.ansiBrightWhite": "#F5EDE1",

    "gitDecoration.modifiedResourceForeground": "#D9AE82",
    "gitDecoration.untrackedResourceForeground": "#9FC48A",
    "gitDecoration.deletedResourceForeground": "#E58B7A",
    "gitDecoration.ignoredResourceForeground": "#685E51"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8B7F6E", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#9FC48A", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator.key-value"],
      "settings": { "foreground": "#9FC48A" }
    },
    {
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#D9AE82" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#E3A07C" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "#E3A07C" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#F5EDE1", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#E8C27A", "fontStyle": "bold" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#E6CBAE", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#9FC48A", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "meta.attribute.python", "variable.other.member"],
      "settings": { "foreground": "#C9B3D6" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#9FC48A", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#E8C27A", "fontStyle": "italic" }
    },
    {
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#E3A07C" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#A39A8D" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#9FC48A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#7FB59A" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#D9AE82" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#9FC48A" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E58B7A" }
    },
    {
      "scope": ["storage.type.java", "storage.type.generic.java", "storage.type.object.array.java", "storage.type.groovy", "storage.type.generic.groovy", "storage.type.object.array.groovy"],
      "settings": { "foreground": "#E8C27A", "fontStyle": "bold" }
    },
    {
      "scope": ["storage.type.string.python", "storage.type.format.python"],
      "settings": { "foreground": "#D9AE82", "fontStyle": "" }
    },
    {
      "scope": ["storage.type.number.python", "storage.type.imaginary.number.python", "storage.type.numeric.bigint", "keyword.other.unit"],
      "settings": { "foreground": "#E3A07C", "fontStyle": "" }
    },
    {
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#C9B3D6", "fontStyle": "" }
    },
    {
      "scope": ["entity.name.command.shell", "support.function.builtin.shell"],
      "settings": { "foreground": "#F5EDE1", "fontStyle": "bold" }
    },
    {
      "scope": ["storage.type.annotation.java", "punctuation.definition.annotation.java", "storage.type.annotation.groovy", "storage.type.annotation.dart", "storage.type.annotation.coffee"],
      "settings": { "foreground": "#E3A07C", "fontStyle": "" }
    },
    {
      "scope": ["constant.other.enum.java"],
      "settings": { "foreground": "#E3A07C" }
    },
    {
      "scope": ["keyword.other.documentation.javadoc", "storage.type.class.jsdoc", "storage.type.class.doc"],
      "settings": { "foreground": "#A39A8D", "fontStyle": "bold italic" }
    },
    {
      "scope": ["support.type.property-name", "support.type.vendored.property-name"],
      "settings": { "foreground": "#C9B3D6", "fontStyle": "" }
    },
    {
      "scope": ["invalid"],
      "settings": { "foreground": "#191612", "background": "#E58B7A" }
    }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#E6CBAE", "italic": true },
    "property": "#C9B3D6",
    "enumMember": "#E3A07C",
    "function": { "foreground": "#F5EDE1", "bold": true },
    "method": { "foreground": "#F5EDE1", "bold": true },
    "class": { "foreground": "#E8C27A", "bold": true },
    "interface": { "foreground": "#E8C27A", "bold": true },
    "type": { "foreground": "#E8C27A", "bold": true },
    "typeParameter": { "foreground": "#E8C27A", "bold": true },
    "enum": { "foreground": "#E8C27A", "bold": true },
    "annotation": "#E3A07C",
    "decorator": "#E3A07C",
    "annotationMember": "#C9B3D6",
    "namespace": "#EADFCF",
    "*.defaultLibrary": { "italic": true }
  }
}
